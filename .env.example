# Copy to .env and fill in. Never commit .env.

# Claude API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Composio API key (dashboard.composio.dev -> settings)
COMPOSIO_API_KEY=

# The Composio user every connected account (Gmail, Notion, Stripe...) belongs to.
# One ID for the agency is enough to start.
COMPOSIO_USER_ID=1media-ops

# Slack channel where agents post approvals and summaries (optional for now)
SLACK_APPROVALS_CHANNEL=
