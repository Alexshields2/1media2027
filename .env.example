# Copy to .env (local) and add the same values in Vercel -> Project -> Settings -> Environment Variables.
# Never commit .env.

# Postgres. On Vercel: add Neon (Storage tab / Marketplace) and it sets this for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onemedia

# Login for the dashboard
ADMIN_PASSWORD=
# Any long random string (signs the login cookie)
AUTH_SECRET=

# Claude API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Composio (dashboard.composio.dev -> settings). Optional: without it agents only use the 1Media OS database.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=1media-ops

# Vercel sends this as a Bearer token on cron calls. Any long random string.
CRON_SECRET=

# Stripe webhook (Stripe -> Developers -> Webhooks -> endpoint /api/webhooks/stripe, event invoice.paid)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Slack incoming webhook for agent summaries and approval alerts.
# Create it from the 1Media OS Slack app (Incoming Webhooks) so the Approve / Reject buttons work.
SLACK_WEBHOOK_URL=
# Jarvis in Slack (/jarvis and approval buttons): Slack app -> Basic Information -> Signing Secret
SLACK_SIGNING_SECRET=
# Comma-separated Slack user IDs allowed to ask Jarvis and approve (recommended), e.g. U012ABCDEF,U034GHIJKL
SLACK_ALLOWED_USER_IDS=
# Optional: only accept requests from this Slack workspace (team ID, starts with T)
SLACK_TEAM_ID=
# Optional: base URL for links in Slack messages (defaults to the Vercel production URL)
APP_URL=
