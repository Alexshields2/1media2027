# Copy to .env (local) and add the same values in Vercel -> Project -> Settings -> Environment Variables.
# Never commit .env.

# Postgres. On Vercel: add Neon (Storage tab / Marketplace) and it sets this for you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onemedia

# Preview deploys (VERCEL_ENV=preview) never use DATABASE_URL: they use this, or run without a database.
PREVIEW_DATABASE_URL=

# Any long random string (signs the session cookie). Strongly recommended.
AUTH_SECRET=
# First run only: while no accounts exist, ADMIN_PASSWORD signs in and creates the first owner.
# With OWNER_EMAIL set, that owner gets this email (and OWNER_NAME); without it, a one-time /setup page asks.
# Once any account exists, ADMIN_PASSWORD no longer works. Add people in Settings.
ADMIN_PASSWORD=
OWNER_EMAIL=
OWNER_NAME=

# Claude API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Composio (dashboard.composio.dev -> settings). Optional: without it agents only use the 1Media OS database.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=1media-ops

# Vercel sends this as a Bearer token on cron calls. Any long random string.
CRON_SECRET=

# Stripe webhook (Stripe -> Developers -> Webhooks -> endpoint /api/webhooks/stripe) with the events
# invoice.paid, invoice.payment_succeeded, invoice.updated, invoice.payment_failed, charge.refunded.
# The webhook only needs the signing secret (whsec_...). STRIPE_SECRET_KEY is optional (not used by the webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Slack incoming webhook for agent summaries and approval alerts
SLACK_WEBHOOK_URL=

# Optional: Notion integration secret, only needed to run `npm run import:notion` (read-only). See README.
NOTION_TOKEN=
